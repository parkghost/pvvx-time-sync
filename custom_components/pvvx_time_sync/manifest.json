{
  "domain": "pvvx_time_sync",
  "name": "pvvx BLE Time Sync",
  "bluetooth": [
    {
      "connectable": true,
      "local_name": "BTH_*"
    },
    {
      "connectable": true,
      "local_name": "BTE_*"
    },
    {
      "connectable": true,
      "local_name": "D02_*"
    }
  ],
  "codeowners": [
    "@parkghost"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth_adapters"
  ],
  "documentation": "https://github.com/parkghost/pvvx-time-sync",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/parkghost/pvvx-time-sync/issues",
  "loggers": [
    "bleak_esphome",
    "bleak_retry_connector"
  ],
  "requirements": [],
  "version": "0.2.0"
}
